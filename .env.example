# ==========================================================
# CampusHire Environment Configuration Template
# Copy this file to .env and configure your production values
# DO NOT COMMIT SENSITIVE PASSWORDS TO VERSION CONTROL
# ==========================================================

# Active Spring Profile (e.g. dev, prod)
SPRING_PROFILES_ACTIVE=prod

# Database Credentials (MySQL 8+)
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=campushire
MYSQL_USER=campushire_app
MYSQL_PASSWORD=your_secure_db_password
MYSQL_PORT=3306

# Spring Datasource Variables (Derived or Custom)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campushire?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=campushire_app
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Application Server Port
SERVER_PORT=8080

# Frontend API URL (for Vite build)
VITE_API_BASE_URL=/api

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
